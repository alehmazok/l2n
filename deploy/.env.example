# Production settings for deploy/compose.yaml. On the VPS: copy to .env next to
# compose.yaml, fill in, `chmod 600 .env`. Never commit the real file.

# Database password. Use letters and digits only (it goes into a URL), e.g.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The domain players open, with its DNS A/AAAA record pointing at the VPS.
# Caddy then gets and renews a Let's Encrypt certificate by itself.
# No domain yet: use :80 and set COOKIE_SECURE=false (plain HTTP, testing only).
SITE_ADDRESS=play.example.com

# Session cookie over HTTPS only. Keep true whenever players use HTTPS.
COOKIE_SECURE=true

# Host ports. Change them if something else on the VPS already uses 80/443
# (then set SITE_ADDRESS=:80 and let that proxy forward to HTTP_PORT).
HTTP_PORT=80
HTTPS_PORT=443
