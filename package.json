{
  "name": "l2n",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./packages/server --filter ./packages/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @l2n/server migrate"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
